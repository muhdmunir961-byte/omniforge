{
  "mcpServers": {
    "omniforge": {
      "type": "stdio",
      "command": "omniforge",
      "args": [
        "mcp"
      ]
    },
    "blender": {
      "type": "stdio",
      "command": "uvx",
      "args": [
        "mcp-for-blender"
      ],
      "env": {
        "BLENDER_HOST": "127.0.0.1",
        "BLENDER_PORT": "9876"
      }
    }
  }
}

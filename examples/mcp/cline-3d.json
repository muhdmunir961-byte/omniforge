{
  "mcpServers": {
    "omniforge": {
      "command": "omniforge",
      "args": [
        "mcp"
      ],
      "disabled": false,
      "autoApprove": []
    },
    "blender": {
      "command": "uvx",
      "args": [
        "mcp-for-blender"
      ],
      "env": {
        "BLENDER_HOST": "127.0.0.1",
        "BLENDER_PORT": "9876"
      },
      "disabled": true,
      "autoApprove": []
    }
  }
}
